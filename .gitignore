# Build artifacts: recreate with .\build.ps1
bin/

# Tool run results (may contain galaxy data); keep the folder's README
output/*
!output/README.md

# Machine-specific configuration, including the galaxy logins in config/credentials.local.ini
config/**/*.local.*

# Working files kept on this machine: per-galaxy tool inputs, open issue lists and reference exports (Metasys)
config/topics/
docs/issues/
docs/references/
